# .env.example
# Copie este arquivo para .env e preencha os valores

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dolar_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=senha

# Airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/dolar_db
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here  # Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# API (série 1 do SGS/BCB = dólar americano venda, diário)
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.1/dados

# Render (produção) — connection string externa do Postgres gerenciado
DATABASE_URL=

# GitHub Actions usa este mesmo valor de DATABASE_URL, configurado como
# secret "RENDER_DATABASE_URL" no repositório (Settings > Secrets > Actions)

# Streamlit
STREAMLIT_PORT=8501