# .env.example
# Copie este arquivo para .env e preencha os valores

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dolar_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=senha

# Airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/dolar_db
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here  # Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# API
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcbr/moeda/moeda/1/diario/dados

# Streamlit
STREAMLIT_PORT=8501